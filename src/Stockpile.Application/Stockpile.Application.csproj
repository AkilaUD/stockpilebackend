<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Stockpile.Contracts\Stockpile.Contracts.csproj" />
    <ProjectReference Include="..\Stockpile.Domain\Stockpile.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validation orchestration lives with the use cases (spec §8); DI extensions
         give Api/Worker AddValidatorsFromAssembly over this project's validators. -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <!-- Task 1.36 — UserManager, IPasswordHasher, IRoleStore and IdentityResult
         for the authentication use cases (the ASP.NET Core-facing Identity
         pieces stay in Api/Infrastructure). -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
