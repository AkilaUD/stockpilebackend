<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Stockpile.Application\Stockpile.Application.csproj" />
    <ProjectReference Include="..\Stockpile.Domain\Stockpile.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />

    <!--
      Security pin for a transitive dependency. Microsoft.Data.SqlClient 6.1.6
      (via EF Core SqlServer) resolves System.Security.Cryptography.Pkcs 9.0.11,
      which CVE-2026-84008 / CVE-2026-70162 (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7,
      published 2026-10-13) mark vulnerable for 9.0.0-9.0.20. 9.0.21 is the patched
      version on the same release line the client expects, so it is binary-compatible;
      it reaches the Api, Worker and test graphs by version unification.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
