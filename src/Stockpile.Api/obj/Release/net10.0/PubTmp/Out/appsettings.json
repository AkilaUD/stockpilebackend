{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  },
  "OpenApi": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrate": false
  },
  "Auth": {
    "RegisteredUserRole": "buyer",
    "RegisteredSupplierRole": "supplierOwner",
    "AbsoluteSessionHours": 12,
    "LockoutBaseMinutes": 15
  },
  "PasswordPolicy": {
    "MinimumLength": 10,
    "BreachCheckEnabled": false
  },
  "Storage": {
    "Root": "../../.storage"
  },

  "Seed": {
    "Comments": "Roles are seeded from configuration, never hard-coded in logic (domain-model §2.2). The Api validates every permission code against Contracts.Permissions.All at startup and fails fast on drift.",
    "Roles": [
      {
        "Code": "platformAdministrator",
        "Name": "Platform administrator",
        "Scope": "Platform",
        "Permissions": [
          "audit.read",
          "security.read",
          "admin.users.unlock",
          "supplier.verify",
          "supplier.suspend",
          "supplier.read.internal",
          "product.moderate",
          "content.publish",
          "content.moderate",
          "review.moderate",
          "rfq.read.any",
          "rfq.match.moderate"
        ]
      },
      {
        "Code": "procurementOperator",
        "Name": "Procurement operator",
        "Scope": "Platform",
        "Permissions": [
          "rfq.read.any",
          "rfq.match",
          "rfq.match.moderate",
          "rfq.close",
          "quote.read.buyer"
        ]
      },
      {
        "Code": "verificationOperator",
        "Name": "Verification operator",
        "Scope": "Platform",
        "Permissions": [
          "supplier.verify",
          "supplier.suspend",
          "supplier.read.internal"
        ]
      },
      {
        "Code": "contentEditor",
        "Name": "Content editor",
        "Scope": "Platform",
        "Permissions": [
          "content.publish",
          "content.moderate",
          "review.moderate"
        ]
      },
      {
        "Code": "financeOperator",
        "Name": "Finance operator",
        "Scope": "Platform",
        "Permissions": [
          "subscription.bill",
          "subscription.manage"
        ]
      },
      {
        "Code": "securityAuditor",
        "Name": "Security auditor",
        "Scope": "Platform",
        "Permissions": [
          "audit.read",
          "security.read"
        ]
      },
      {
        "Code": "buyerAdmin",
        "Name": "Buyer administrator",
        "Scope": "Organization",
        "Permissions": [
          "rfq.create",
          "rfq.read.own",
          "rfq.submit",
          "rfq.cancel",
          "rfq.close",
          "rfq.award",
          "quote.read.buyer",
          "quote.accept",
          "quote.decline",
          "quote.requestRevision",
          "order.create",
          "order.read.own",
          "order.cancel",
          "order.dispute",
          "review.create",
          "organization.member.manage"
        ]
      },
      {
        "Code": "buyer",
        "Name": "Buyer",
        "Scope": "Organization",
        "Permissions": [
          "rfq.create",
          "rfq.read.own",
          "rfq.submit",
          "rfq.cancel",
          "quote.read.buyer",
          "order.create",
          "order.read.own",
          "review.create"
        ]
      },
      {
        "Code": "supplierOwner",
        "Name": "Supplier owner",
        "Scope": "Supplier",
        "Permissions": [
          "product.create",
          "product.update.own",
          "product.publish",
          "quote.submit",
          "quote.revise",
          "quote.read.supplier",
          "quote.withdraw",
          "rfq.match.decline",
          "subscription.manage",
          "supplier.update.own",
          "order.fulfill",
          "order.dispute"
        ]
      },
      {
        "Code": "supplierUser",
        "Name": "Supplier user",
        "Scope": "Supplier",
        "Permissions": [
          "product.create",
          "product.update.own",
          "quote.submit",
          "quote.revise",
          "quote.read.supplier",
          "quote.withdraw",
          "rfq.match.decline",
          "order.fulfill"
        ]
      }
    ]
  }
}
